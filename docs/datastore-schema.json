{
  "$schema": "https://medguard.example/schema/catalyst-datastore-v1.json",
  "notes": "Create these tables in Catalyst Data Store. ROWID, CREATEDTIME and MODIFIEDTIME are Catalyst-managed columns.",
  "tables": [
    {"name":"Medicines","columns":[{"name":"medicine_id","type":"String","unique":true,"mandatory":true},{"name":"medicine_name","type":"String","mandatory":true},{"name":"category","type":"String","mandatory":true},{"name":"manufacturer","type":"String","mandatory":true},{"name":"dosage","type":"String","mandatory":true},{"name":"created_time","type":"DateTime","mandatory":true}]},
    {"name":"Users","columns":[{"name":"user_id","type":"String","unique":true,"mandatory":true},{"name":"name","type":"String","mandatory":true},{"name":"email","type":"Email","mandatory":true},{"name":"role","type":"String","mandatory":true,"allowed_values":["Admin","Pharmacist"]},{"name":"branch","type":"String","mandatory":true},{"name":"phone","type":"String","mandatory":true}]},
    {"name":"Batches","columns":[{"name":"batch_id","type":"String","unique":true,"mandatory":true},{"name":"medicine_rowid","type":"Lookup","references":{"table":"Medicines","column":"ROWID"},"mandatory":true},{"name":"batch_no","type":"String","unique":true,"mandatory":true},{"name":"quantity","type":"Number","mandatory":true},{"name":"manufacture_date","type":"Date","mandatory":true},{"name":"expiry_date","type":"Date","mandatory":true},{"name":"status","type":"String","mandatory":true,"allowed_values":["Active","Expiring","Expired","Blocked"]},{"name":"branch","type":"String","mandatory":true},{"name":"created_by","type":"Lookup","references":{"table":"Users","column":"ROWID"},"mandatory":true},{"name":"updated_time","type":"DateTime","mandatory":true}]},
    {"name":"Alert_Logs","columns":[{"name":"alert_id","type":"String","unique":true,"mandatory":true},{"name":"batch_rowid","type":"Lookup","references":{"table":"Batches","column":"ROWID"},"mandatory":true},{"name":"alert_type","type":"String","mandatory":true,"allowed_values":["30 Days","15 Days","7 Days","Expired","Low Stock"]},{"name":"alert_date","type":"DateTime","mandatory":true},{"name":"sent_to","type":"String","mandatory":true},{"name":"status","type":"String","mandatory":true}]}
  ]
}
